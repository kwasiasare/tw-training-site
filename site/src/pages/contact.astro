---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComplaintForm from '../components/ComplaintForm.astro';
---

<BaseLayout title="Contact & Feedback" description="Send us a complaint or suggestion — we read every message.">
  <section class="lesson">
    <div class="container">
      <h1>Contact &amp; feedback</h1>
      <p class="summary">
        Found a problem or have an idea for how we could do better? Send us a complaint or suggestion below
        and it goes straight to our team — no account needed.
      </p>
      <ComplaintForm />
    </div>
  </section>
</BaseLayout>
