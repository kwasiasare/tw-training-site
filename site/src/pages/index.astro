---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COURSES, courseLessonCount, courseModules } from '../consts';
import { getCollection } from 'astro:content';

const topics = await getCollection('topics');
const totalLessons = topics.length;
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>Project-based courses to your first AI role.</h1>
      <p>
        Self-study courses built around what employers actually want: shipped projects.
        In-depth notes, interactive quizzes, instructor videos, and a portfolio you can show.
      </p>
      <a class="btn" href="#courses">Browse the courses</a>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <h2 class="section-title">How it works</h2>
      <p class="section-sub">
        Each course is a sequence of short lessons grouped into modules. Every lesson has a
        video, in-depth notes, and an interactive quiz. {totalLessons} lessons across {COURSES.length} courses.
      </p>
      <div class="grid cols-2">
        <div class="card"><h3>1. Learn</h3><p class="theme">Watch the lesson video and read the in-depth notes.</p></div>
        <div class="card"><h3>2. Check</h3><p class="theme">Take the interactive quiz — instant feedback, no answer key.</p></div>
        <div class="card"><h3>3. Build</h3><p class="theme">Do the exercises and the module deliverable. Push to GitHub.</p></div>
        <div class="card"><h3>4. Ship</h3><p class="theme">Deploy, document, and present your work to land the role.</p></div>
      </div>
    </div>
  </section>

  <section class="block soft" id="courses">
    <div class="container">
      <h2 class="section-title">Courses</h2>
      <p class="section-sub">Pick the path that matches where you're starting from.</p>
      <div class="grid cols-2">
        {COURSES.map((c) => {
          const mods = courseModules(topics, c.slug);
          const count = courseLessonCount(topics, c.slug);
          return (
            <div class="card course-card" style={`--accent:${c.accent}`}>
              <span class="badge" style={`background:${c.accent}`}>{count} lessons · {mods.length} modules</span>
              <h3>{c.title}</h3>
              <p class="theme">{c.blurb}</p>
              <ul class="topic-list">
                {mods.map((m) => (
                  <li class="has-video"><span class="lz">{String(m.month).padStart(2, '0')}</span>{m.monthTitle}</li>
                ))}
              </ul>
              <p style="margin-top:16px">
                <a class="btn" href={`/courses/${c.slug}/`}>View course &rarr;</a>
              </p>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
