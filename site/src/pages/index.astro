---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COURSES, courseLessonCount, courseModules } from '../consts';
import { getCollection } from 'astro:content';

const topics = await getCollection('topics');
const totalLessons = topics.length;

// Build a small client-side search index over every lesson in every course.
const courseTitle = Object.fromEntries(COURSES.map((c) => [c.slug, c.title]));
const lessonIndex = topics
  .map((t) => ({
    id: t.id,
    course: t.data.course,
    courseTitle: courseTitle[t.data.course] ?? t.data.course,
    title: t.data.title,
    summary: t.data.summary,
    module: t.data.monthTitle,
  }))
  .sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>Project-based courses to your first IT role.</h1>
      <p>
        Self-study courses built around what employers actually want: shipped projects. Every
        course ends with a portfolio-ready capstone, with résumé and LinkedIn coaching to make you
        job-ready.
      </p>
      <a class="btn" href="#courses">Browse the courses</a>
    </div>
  </section>

  <section class="block" id="courses">
    <div class="container">
      <h2 class="section-title">Courses</h2>
      <p class="section-sub">Pick the path that matches where you're starting from. Every lesson includes an instructor video, in-depth notes, and an interactive quiz.</p>
      <div class="course-grid">
        {COURSES.map((c) => {
          const mods = courseModules(topics, c.slug);
          const count = courseLessonCount(topics, c.slug);
          return (
            <a class="course-tile" href={`/courses/${c.slug}/`} style={`--accent:${c.accent}`}>
              <span class="course-tile-meta" aria-hidden="true">{count} lessons &middot; {mods.length} modules</span>
              <h3>{c.title}</h3>
              <p class="course-tile-tagline">{c.cardBlurb}</p>
              <span class="course-tile-cta" aria-hidden="true">View course &rarr;</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="block soft" id="search">
    <div class="container">
      <h2 class="section-title">Find a lesson</h2>
      <p class="section-sub">Search across all {totalLessons} lessons in every course.</p>
      <input
        id="lesson-search"
        class="search-input"
        type="search"
        placeholder="Search lessons by title or topic…"
        autocomplete="off"
        aria-label="Search lessons"
      />
      <div id="search-results" class="search-results" hidden></div>
    </div>
  </section>

  <script type="application/json" id="lesson-index" set:html={JSON.stringify(lessonIndex)}></script>
  <script is:inline>
    (function () {
      var el = document.getElementById('lesson-index');
      var idx = [];
      try { idx = JSON.parse(el.textContent || '[]'); } catch (e) {}
      var input = document.getElementById('lesson-search');
      var out = document.getElementById('search-results');
      if (!input || !out) return;
      function esc(s) {
        return String(s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function render(q) {
        q = q.trim().toLowerCase();
        if (!q) { out.hidden = true; out.innerHTML = ''; return; }
        var matches = idx.filter(function (l) {
          return (l.title + ' ' + l.summary + ' ' + l.module + ' ' + l.courseTitle)
            .toLowerCase().indexOf(q) !== -1;
        }).slice(0, 40);
        out.hidden = false;
        if (!matches.length) {
          out.innerHTML = '<p class="theme">No lessons match &ldquo;' + esc(q) + '&rdquo;.</p>';
          return;
        }
        out.innerHTML =
          '<p class="theme">' + matches.length + ' result' + (matches.length === 1 ? '' : 's') + '</p>' +
          '<ul class="topic-list">' + matches.map(function (l) {
            return '<li class="has-video"><a href="/topics/' + l.id + '/">' + esc(l.title) +
              '</a> <span class="lz">' + esc(l.courseTitle) + ' &middot; ' + esc(l.module) + '</span></li>';
          }).join('') + '</ul>';
      }
      input.addEventListener('input', function () { render(input.value); });
    })();
  </script>
</BaseLayout>
