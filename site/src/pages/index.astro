---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COURSES, courseLessonCount, courseModules } from '../consts';
import { getCollection } from 'astro:content';

const topics = await getCollection('topics');
const totalLessons = topics.length;

// Build a small client-side search index over every lesson in every course.
const courseTitle = Object.fromEntries(COURSES.map((c) => [c.slug, c.title]));
const lessonIndex = topics
  .map((t) => ({
    id: t.id,
    course: t.data.course,
    courseTitle: courseTitle[t.data.course] ?? t.data.course,
    title: t.data.title,
    summary: t.data.summary,
    module: t.data.monthTitle,
  }))
  .sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>Project-based courses to your first AI role.</h1>
      <p>
        Self-study courses built around what employers actually want: shipped projects.
        In-depth notes, interactive quizzes, instructor videos, and a portfolio you can show.
      </p>
      <a class="btn" href="#courses">Browse the courses</a>
    </div>
  </section>

  <section class="block" id="search">
    <div class="container">
      <h2 class="section-title">Find a lesson</h2>
      <p class="section-sub">Search across all {totalLessons} lessons in every course.</p>
      <input
        id="lesson-search"
        class="search-input"
        type="search"
        placeholder="Search lessons by title or topic…"
        autocomplete="off"
        aria-label="Search lessons"
      />
      <div id="search-results" class="search-results" hidden></div>
    </div>
  </section>

  <section class="block soft">
    <div class="container">
      <h2 class="section-title">How it works</h2>
      <p class="section-sub">
        Each course is a sequence of short lessons grouped into modules. Every lesson has a
        video, in-depth notes, and an interactive quiz. {totalLessons} lessons across {COURSES.length} courses.
      </p>
      <div class="grid cols-2">
        <div class="card"><h3>1. Learn</h3><p class="theme">Watch the lesson video and read the in-depth notes.</p></div>
        <div class="card"><h3>2. Check</h3><p class="theme">Take the interactive quiz — instant feedback, no answer key.</p></div>
        <div class="card"><h3>3. Build</h3><p class="theme">Do the exercises and the module deliverable. Push to GitHub.</p></div>
        <div class="card"><h3>4. Ship</h3><p class="theme">Deploy, document, and present your work to land the role.</p></div>
      </div>
    </div>
  </section>

  <section class="block" id="courses">
    <div class="container">
      <h2 class="section-title">Courses</h2>
      <p class="section-sub">Pick the path that matches where you're starting from.</p>
      <div class="grid cols-2">
        {COURSES.map((c) => {
          const mods = courseModules(topics, c.slug);
          const count = courseLessonCount(topics, c.slug);
          return (
            <div class="card course-card" style={`--accent:${c.accent}`}>
              <span class="badge" style={`background:${c.accent}`}>{count} lessons · {mods.length} modules</span>
              <h3>{c.title}</h3>
              <p class="theme">{c.blurb}</p>
              <ul class="topic-list">
                {mods.map((m) => (
                  <li class="has-video"><span class="lz">{String(m.month).padStart(2, '0')}</span>{m.monthTitle}</li>
                ))}
              </ul>
              <p style="margin-top:16px">
                <a class="btn" href={`/courses/${c.slug}/`}>View course &rarr;</a>
              </p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <script type="application/json" id="lesson-index" set:html={JSON.stringify(lessonIndex)}></script>
  <script is:inline>
    (function () {
      var el = document.getElementById('lesson-index');
      var idx = [];
      try { idx = JSON.parse(el.textContent || '[]'); } catch (e) {}
      var input = document.getElementById('lesson-search');
      var out = document.getElementById('search-results');
      if (!input || !out) return;
      function esc(s) {
        return String(s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function render(q) {
        q = q.trim().toLowerCase();
        if (!q) { out.hidden = true; out.innerHTML = ''; return; }
        var matches = idx.filter(function (l) {
          return (l.title + ' ' + l.summary + ' ' + l.module + ' ' + l.courseTitle)
            .toLowerCase().indexOf(q) !== -1;
        }).slice(0, 40);
        out.hidden = false;
        if (!matches.length) {
          out.innerHTML = '<p class="theme">No lessons match &ldquo;' + esc(q) + '&rdquo;.</p>';
          return;
        }
        out.innerHTML =
          '<p class="theme">' + matches.length + ' result' + (matches.length === 1 ? '' : 's') + '</p>' +
          '<ul class="topic-list">' + matches.map(function (l) {
            return '<li class="has-video"><a href="/topics/' + l.id + '/">' + esc(l.title) +
              '</a> <span class="lz">' + esc(l.courseTitle) + ' &middot; ' + esc(l.module) + '</span></li>';
          }).join('') + '</ul>';
      }
      input.addEventListener('input', function () { render(input.value); });
    })();
  </script>
</BaseLayout>
