---
// Site-wide branding footer (TW-133). Rendered once by BaseLayout on every page.
import { SITE, COMPANY } from '../consts';
---

<footer class="site-footer">
  <div class="container footer-cols">
    <div class="footer-brand">
      <img class="footer-logo" src="/spreadcom-logo.jpg" alt={`${COMPANY.name} logo`} width="40" height="40" />
      <p>Application created by <strong>{COMPANY.name}</strong></p>
      <p>{SITE.tagline}</p>
    </div>

    <div class="footer-contact">
      <h4>Contact</h4>
      <p><a href={COMPANY.website} target="_blank" rel="noopener">{COMPANY.website}</a></p>
      <p><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></p>
      <p><a href={COMPANY.phoneHref}>{COMPANY.phone}</a></p>
      <p>{COMPANY.location}</p>
    </div>

    <div class="footer-links">
      <h4>Links</h4>
      <p><a href="/">Home</a></p>
      <p><a href="/#courses">Courses</a></p>
      <p><a href="/contact">Contact</a></p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; 2026 {COMPANY.name}. All rights reserved.</p>
    <p><strong>{SITE.title}</strong> — A self-study course. Built with Astro, hosted on Azure Static Web Apps.</p>
  </div>
</footer>
