---
// In-lesson AI tutor (TW-67). A collapsible chat panel that asks /api/tutor a
// question grounded in THIS lesson. Auth-gated server-side; signed-out users get a
// sign-in prompt. Model replies are rendered with a safe, DOM-building markdown
// renderer (chat-panel.ts's renderMarkdownInto) — never innerHTML — so a reply
// can't inject markup while still displaying **bold**/`code`/bullets correctly.
interface Props {
  course?: string;
  lesson?: string; // lesson id (topic.id)
}
const { course, lesson } = Astro.props;
---

{lesson && (
  <section class="tutor" data-tutor data-course={course} data-lesson={lesson}>
    <details>
      <summary>
        <span class="tutor-title">Ask the AI tutor about this lesson</span>
        <span class="tutor-hint theme">Stuck or curious? Ask a question and get a grounded answer.</span>
      </summary>

      <div class="tutor-body">
        <div class="tutor-log" data-tutor-log aria-live="polite"></div>
        <form class="tutor-form" data-tutor-form>
          <textarea
            data-tutor-input
            rows="2"
            maxlength="2000"
            placeholder="e.g. Can you explain the owned / earned / paid framework with an example?"
            aria-label="Ask the AI tutor a question about this lesson"
          ></textarea>
          <button class="btn" type="submit" data-tutor-send>Ask</button>
        </form>
        <p class="tutor-foot theme">The tutor answers from this lesson's material and can make mistakes — verify anything important.</p>
      </div>
    </details>
  </section>
)}

<style>
  .tutor { margin: 2rem 0; }
  .tutor details {
    border: 1px solid var(--border, #2a2a35);
    border-radius: 12px;
    background: var(--card, #16161d);
    padding: 0;
    overflow: hidden;
  }
  .tutor summary {
    cursor: pointer;
    list-style: none;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .tutor summary::-webkit-details-marker { display: none; }
  .tutor-title { font-weight: 600; }
  .tutor-hint { font-size: 0.85rem; }
  .tutor-body { padding: 0 1.25rem 1.25rem; }
  .tutor-log { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 0.75rem; }
  .tutor-msg { padding: 0.6rem 0.85rem; border-radius: 10px; white-space: pre-wrap; line-height: 1.5; }
  .tutor-msg.user { background: var(--accent-soft, #2a2440); align-self: flex-end; max-width: 85%; }
  .tutor-msg.bot { background: var(--surface, #1e1e27); align-self: flex-start; max-width: 95%; white-space: normal; }
  .tutor-msg.err { background: #3a1e1e; color: #ffb4b4; align-self: stretch; }

  /* Rendered-markdown bot bubbles (TW-126). Message bubbles are created at
     runtime by chat-panel.ts, so they never receive Astro's scoped
     data-astro-cid-* attribute that the plain selectors above rely on —
     these descendant rules are wrapped in :global() (anchored on the
     statically-rendered .tutor-log ancestor) so they actually match. */
  .tutor-log :global(.tutor-msg.bot p),
  .tutor-log :global(.tutor-msg.bot ul),
  .tutor-log :global(.tutor-msg.bot ol) {
    margin: 0 0 0.5rem;
  }
  .tutor-log :global(.tutor-msg.bot p:last-child),
  .tutor-log :global(.tutor-msg.bot ul:last-child),
  .tutor-log :global(.tutor-msg.bot ol:last-child) {
    margin-bottom: 0;
  }
  .tutor-log :global(.tutor-msg.bot ul),
  .tutor-log :global(.tutor-msg.bot ol) {
    padding-left: 1.25rem;
  }
  .tutor-log :global(.tutor-msg.bot li) {
    margin: 0.15rem 0;
  }
  .tutor-log :global(.tutor-msg.bot code) {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    font-size: 0.9em;
  }
  .tutor-form { display: flex; gap: 0.5rem; align-items: flex-end; }
  .tutor-form textarea {
    flex: 1;
    resize: vertical;
    border-radius: 10px;
    border: 1px solid var(--border, #2a2a35);
    background: var(--surface, #1e1e27);
    color: inherit;
    padding: 0.6rem 0.75rem;
    font: inherit;
  }
  .tutor-foot { font-size: 0.78rem; margin: 0.6rem 0 0; }
</style>

<script>
  import { attachChatPanel } from '../scripts/chat-panel';

  document.querySelectorAll('[data-tutor]').forEach((root) => {
    const lesson = root.getAttribute('data-lesson');
    if (!lesson) return;

    attachChatPanel({
      root,
      endpoint: '/api/tutor',
      buildBody: (history) => ({ lesson, messages: history }),
      maxHistory: 8,
      signInMessage: 'Please sign in to use the tutor.',
      cannotAnswerMessage: "I couldn't answer that one — try rephrasing or asking something about this lesson.",
      selectors: {
        log: '[data-tutor-log]',
        form: '[data-tutor-form]',
        input: '[data-tutor-input]',
        send: '[data-tutor-send]',
      },
      msgClassPrefix: 'tutor-msg',
    });
  });
</script>
