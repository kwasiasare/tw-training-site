---
import '../styles/global.css';
import { SITE, AUTH_ENABLED, CUSTOM_ADVISOR_ENABLED, CHATBOT_ENABLED } from '../consts';
import Analytics from '../components/Analytics.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — Course`;
// www.salloma.com is the canonical host; build a self-referential canonical URL.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.salloma.com').href;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Redirect the apex domain to the canonical www host (SWA has no host-based redirect). */}
    <script is:inline>
      (function () {
        if (location.hostname === 'salloma.com') {
          location.replace('https://www.salloma.com' + location.pathname + location.search + location.hash);
        }
      })();
    </script>
    {/* Apply the saved theme before paint to avoid a flash. Defaults to dark. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? SITE.tagline} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">{SITE.title}</a>
        <nav class="nav">
          <a href="/">Home</a>
          <a href="/#courses">Courses</a>
          {AUTH_ENABLED && CUSTOM_ADVISOR_ENABLED && <a href="/custom">Custom training</a>}
          {AUTH_ENABLED && <span id="auth-area" class="auth-area"><a href="/.auth/login/entraExternalId?post_login_redirect_uri=/account/">Sign in</a></span>}
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode"></button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <strong>{SITE.title}</strong> — {SITE.tagline}.<br />
        A self-study course. Built with Astro, hosted on Azure Static Web Apps.
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        function cur() { return document.documentElement.getAttribute('data-theme') || 'dark'; }
        function paint() { btn.textContent = cur() === 'dark' ? '☀' : '☾'; }
        paint();
        btn.addEventListener('click', function () {
          var next = cur() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          paint();
        });
      })();
    </script>
    {AUTH_ENABLED && (
      <script is:inline>
        (function () {
          var area = document.getElementById('auth-area');
          if (!area) return;
          fetch('/.auth/me', { headers: { accept: 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
              var p = d && d.clientPrincipal;
              if (p) {
                var name = (p.userDetails || 'Account').replace(/[<>&"]/g, '');
                var admin = (p.userRoles || []).indexOf('administrator') !== -1
                  ? '<a href="/admin/">Admin</a> ' : '';
                area.innerHTML = admin + '<a href="/account/">' + name + '</a> ' +
                  '<a href="/.auth/logout?post_logout_redirect_uri=/">Sign out</a>';
              }
            })
            .catch(function () {});
        })();
      </script>
    )}
    {AUTH_ENABLED && <script is:inline src="/progress.js" defer></script>}
    {CHATBOT_ENABLED && <ChatWidget />}
  </body>
</html>
