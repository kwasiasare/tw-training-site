{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "auth": {
    "rolesSource": "/api/GetRoles",
    "identityProviders": {
      "customOpenIdConnectProviders": {
        "entraExternalId": {
          "registration": {
            "clientIdSettingName": "ENTRA_CLIENT_ID",
            "clientCredential": { "clientSecretSettingName": "ENTRA_CLIENT_SECRET" },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://twtraining.ciamlogin.com/5afbd9ae-47c9-4043-bdb4-d32557aae15d/v2.0/.well-known/openid-configuration"
            }
          },
          "login": { "scopes": ["openid", "profile", "email"] }
        }
      }
    }
  },
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/videos/*", "/*.{png,jpg,svg,css,js,mp4,webm}"]
  },
  "mimeTypes": {
    ".mp4": "video/mp4",
    ".webm": "video/webm"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  },
  "routes": [
    { "route": "/api/GetRoles", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/video", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/tutor", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/chat", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/grade", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/certificate", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/stats", "allowedRoles": ["authenticated"] },
    { "route": "/api/profile", "allowedRoles": ["authenticated"] },
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/admin", "allowedRoles": ["administrator"] },
    { "route": "/admin/*", "allowedRoles": ["administrator"] },
    { "route": "/topics/aad-m1-l01-python-essentials-for-ai-developers*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/aad-m1-l02-calling-your-first-llm-api*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/age-m1-l01-calling-llm-apis-in-python-completions-chat-and-*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/age-m1-l02-prompt-engineering-and-system-design-for-agent-b*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/apm-m1-l01-how-modern-ai-works-a-no-math-mental-model-for-p*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/apm-m1-l02-inside-llms-tokens-context-windows-and-how-they-*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/cse-m1-l01-zero-trust-foundations-and-the-security-stack*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/cse-m1-l02-architecting-conditional-access-policies*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/dm-m1-l01-the-digital-marketing-landscape-the-assistant-ro*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/dm-m1-l02-copywriting-that-converts-for-social-and-ads*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/dsc-m1-l01-python-essentials-for-data-work*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/dsc-m1-l02-loading-and-cleaning-data-with-pandas*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/g1-l01-how-llms-behave*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/g1-l02-where-llms-fail*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/hd1-l01-how-a-computer-works*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/hd1-l02-inside-the-pc*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/ht1-l01-the-tier3-mindset-and-rca*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/ht1-l02-advanced-windows-internals*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/mle-m1-l01-python-for-ml-numpy-pandas-and-clean-code*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/mle-m1-l02-linear-algebra-in-action-with-numpy*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/mlo-m1-l01-setting-up-your-mlops-toolchain-and-workflow*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/mlo-m1-l02-containerizing-a-machine-learning-model-with-doc*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/*", "allowedRoles": ["authenticated"] },
    {
      "route": "/videos/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    }
  ],
  "responseOverrides": {
    "401": { "redirect": "/signin/", "statusCode": 302 }
  }
}
