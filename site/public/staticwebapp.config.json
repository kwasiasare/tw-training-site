{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "auth": {
    "rolesSource": "/api/GetRoles",
    "identityProviders": {
      "customOpenIdConnectProviders": {
        "entraExternalId": {
          "registration": {
            "clientIdSettingName": "ENTRA_CLIENT_ID",
            "clientCredential": { "clientSecretSettingName": "ENTRA_CLIENT_SECRET" },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://twtraining.ciamlogin.com/5afbd9ae-47c9-4043-bdb4-d32557aae15d/v2.0/.well-known/openid-configuration"
            }
          },
          "login": { "scopes": ["openid", "profile", "email"] }
        }
      }
    }
  },
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/videos/*", "/*.{png,jpg,svg,css,js,mp4,webm}"]
  },
  "mimeTypes": {
    ".mp4": "video/mp4",
    ".webm": "video/webm"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  },
  "routes": [
    { "route": "/api/GetRoles", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/video", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/tutor", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/grade", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/certificate", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/api/stats", "allowedRoles": ["authenticated"] },
    { "route": "/api/profile", "allowedRoles": ["authenticated"] },
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/admin", "allowedRoles": ["administrator"] },
    { "route": "/admin/*", "allowedRoles": ["administrator"] },
    { "route": "/topics/aad-m1-l01-python-essentials-for-ai-developers*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/aad-m1-l02-calling-your-first-llm-api*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/g1-l01-how-llms-behave*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/g1-l02-where-llms-fail*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/hd1-l01-how-a-computer-works*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/hd1-l02-inside-the-pc*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/ht1-l01-the-tier3-mindset-and-rca*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/ht1-l02-advanced-windows-internals*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/topics/*", "allowedRoles": ["authenticated"] },
    {
      "route": "/videos/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    }
  ],
  "responseOverrides": {
    "401": { "redirect": "/signin/", "statusCode": 302 }
  }
}
