{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/videos/*", "/*.{png,jpg,svg,css,js,mp4,webm}"]
  },
  "mimeTypes": {
    ".mp4": "video/mp4",
    ".webm": "video/webm"
  },
  "routes": [
    {
      "route": "/videos/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    }
  ]
}
