# ─── Secrets ───────────────────────────────────────────────
.env
*.env
!.env.example
# Azure Functions local settings hold real connection strings/keys — never commit.
local.settings.json
api/local.settings.json

# ─── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ─── Node / Astro (site) ───────────────────────────────────
node_modules/
dist/
.astro/

# ─── Large media (served from Cloudflare R2, never committed) ─
# Rendered lesson videos live inside each self-contained course folder:
course-materials/*/videos/*.mp4
# Legacy local video path (kept for safety) + render/narration scratch:
site/public/videos/*.mp4
videos/_render/
videos/_auditions/
videos/M1_Functions/
*.mp4
*.wav
*.mp3

# Keep the per-course videos/ folder present on clone (it is otherwise empty).
!course-materials/*/videos/.gitkeep

# ─── OS / editor noise ─────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
