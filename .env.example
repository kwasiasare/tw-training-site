# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# ─── Azure Speech (Neural TTS for narration) ───────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ─── Azure TTS Avatar (TW-134, video presenter mode) ───────
# SEPARATE Speech resource required: avatar batch synthesis only works in
# westus2 / westeurope / southeastasia (S0 tier). The eastus resource above
# CANNOT do avatars. See HOWTO_Azure_Avatar.md. ~€1.74 per minute of output.
AZURE_AVATAR_SPEECH_KEY=
AZURE_AVATAR_SPEECH_REGION=westus2
# Optional; defaults to https://<region>.api.cognitive.microsoft.com
AZURE_AVATAR_ENDPOINT=

# ─── Cloudflare R2 (video hosting — zero egress) ───────────
# See HOWTO_Cloudflare_R2.md for step-by-step setup.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tw-course-videos
# Public base URL of the bucket (r2.dev dev URL, or your custom domain):
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ─── Custom Training Advisor (TW-61) ───────────────────────
# Claude API key for résumé analysis + course generation (Anthropic Console).
ANTHROPIC_API_KEY=
# Private R2 bucket for uploaded résumés (PII — keep it PRIVATE, no public access).
# See HOWTO_Resume_Storage.md. Dedicated token scoped to this bucket; falls back
# to the R2_* creds above if these are unset (not recommended — least privilege).
RESUME_R2_BUCKET=tw-resumes
RESUME_R2_ACCESS_KEY_ID=
RESUME_R2_SECRET_ACCESS_KEY=
# An R2 token with bucket-create permission, used ONLY by setup_r2_resumes.py to
# provision the bucket (not by the app). Leave blank to fall back to R2_* creds.
R2_ADMIN_ACCESS_KEY_ID=
R2_ADMIN_SECRET_ACCESS_KEY=

# Admin notification when a user requests a custom course (best-effort; no-op if
# unset). Configure ONE channel. Recipient defaults to kasare@spreadcomgh.com.
NOTIFY_EMAIL=kasare@spreadcomgh.com
# Option A — Resend (https://resend.com): an API key + a verified from-address.
RESEND_API_KEY=
NOTIFY_FROM=onboarding@resend.dev
# Option B — a webhook that sends the email (e.g. a Power Automate / Logic App flow
# "When an HTTP request is received" → Office 365 send email). Receives {to,subject,text}.
NOTIFY_WEBHOOK_URL=
# The public contact/complaints form (TW-133, POST /api/complaint) reuses this
# same NOTIFY_EMAIL / RESEND_API_KEY / NOTIFY_FROM / NOTIFY_WEBHOOK_URL channel —
# no separate config needed. It has its own anonymous, IP-only rate limit:
FEEDBACK_RL_IP_MAX=5
FEEDBACK_RL_IP_WINDOW_MS=3600000
